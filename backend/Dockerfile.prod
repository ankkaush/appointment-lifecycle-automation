# Production image (Phase 10): no --reload, no bind-mounted source, runs
# as a non-root user. docker-compose.yml's dev `api`/`worker` services
# keep using the plain Dockerfile with a bind mount and --reload;
# docker-compose.prod.yml builds this one instead. Not a multi-stage
# build -- asyncpg installs from a prebuilt wheel on this base image (no
# libpq-dev/gcc needed to build anything), so there's no build-only
# layer worth discarding.
FROM python:3.12-slim

WORKDIR /app

RUN useradd --create-home --uid 1000 appuser

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=appuser:appuser . .

USER appuser

# Multiple worker processes, no --reload, no source bind mount --
# migrations are a separate step (see DEPLOYMENT.md), deliberately not
# run automatically on container start: racing N replicas through
# `alembic upgrade head` on boot is exactly the kind of surprise a
# production rollout shouldn't have to debug.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
