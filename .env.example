# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://appointment:changeme@localhost:5432/appointment_automation

# --- App ---
APP_ENV=development
SECRET_KEY=replace-with-a-random-value

# --- AI interpretation layer (Phase 2) ---
ANTHROPIC_API_KEY=sk-ant-replace-me
AI_MODEL=claude-haiku-4-5-20251001

# --- Calendar provider (Phase 4). "mock" requires no credentials. ---
CALENDAR_PROVIDER=mock
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Notifications (interface in Phase 3, real provider in Phase 8) ---
# NOTIFICATION_PROVIDER: "console" (default, no credentials -- logs and
# persists, doesn't contact any real provider), "resend" (real email,
# needs both keys below), or "mock" (silent -- what tests use).
NOTIFICATION_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Observability (Phase 9) ---
SENTRY_DSN=
